@model List<HotelBookingApp.Dto.ReportDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Generate Report";
}

<h2>Generate Report</h2>

<form method="post" asp-action="Generate" class="mt-4 mb-4">
    <div class="mb-3 row">
        <label for="fromDate" class="col-sm-2 col-form-label">From Date:</label>
        <div class="col-sm-4">
            <input type="date" class="form-control" id="fromDate" name="fromDate" value="@ViewBag.FromDate" required />
        </div>
    </div>
    <div class="mb-3 row">
        <label for="toDate" class="col-sm-2 col-form-label">To Date:</label>
        <div class="col-sm-4">
            <input type="date" class="form-control" id="toDate" name="toDate" value="@ViewBag.ToDate" required />
        </div>
    </div>
    <div class="mb-3 row">
        <div class="col-sm-6">
            <button type="submit" class="btn btn-primary w-100">Generate Report</button>
        </div>
    </div>
</form>

@if (Model != null && Model.Any())
{
    <h3>Summary Report</h3>

    <table class="table table-striped table-hover mt-4">
        <thead class="table-dark">
            <tr>
                <th>Hotel</th>
                <th>Total Bookings</th>
                <th>Active Bookings</th>
                <th>Cancelled Bookings</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model)
            {
                <tr>
                    <td>@report.HotelName</td>
                    <td>@report.TotalBookings</td>
                    <td>@report.ActiveBookings</td>
                    <td>@report.CancelledBookings</td>
                </tr>
            }
        </tbody>
    </table>

    <h3 class="mt-5">Visual Report</h3>
    <canvas id="reportChart" width="600" height="300"></canvas>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.HotelName)));
        const totalData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.TotalBookings)));
        const activeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.ActiveBookings)));
        const cancelledData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.CancelledBookings)));

        const ctx = document.getElementById('reportChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Total Bookings',
                        data: totalData,
                        backgroundColor: 'rgba(54, 162, 235, 0.7)'
                    },
                    {
                        label: 'Active Bookings',
                        data: activeData,
                        backgroundColor: 'rgba(75, 192, 192, 0.7)'
                    },
                    {
                        label: 'Cancelled Bookings',
                        data: cancelledData,
                        backgroundColor: 'rgba(255, 99, 132, 0.7)'
                    }
                ]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { precision: 0 }
                    }
                }
            }
        });
    </script>
}
else
{
    <div class="alert alert-info mt-4">Please select a date range to generate the report.</div>
}
