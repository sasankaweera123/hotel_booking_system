@model HotelBookingApp.Dto.RoomDto

<div class="container mt-4">
    <h2>Create Room</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="post" class="card p-3 shadow-sm">
        <div class="mb-3">
            <label class="form-label">Room Number</label>
            <input asp-for="RoomNumber" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Room Type ID</label>
            <input asp-for="RoomTypeId" type="number" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Hotel ID</label>
            <input asp-for="HotelId" type="number" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-success">Create</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>