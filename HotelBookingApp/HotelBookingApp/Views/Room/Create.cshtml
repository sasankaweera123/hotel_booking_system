@model HotelBookingApp.Dto.RoomDto
@inject HotelBookingApp.Services.RoomService RoomService

@{
    ViewBag.Title = "Create Room";
    var hotels = await RoomService.GetHotelsAsync();
    var roomTypes = await RoomService.GetRoomTypesAsync();
}

<div class="container mt-4">
    <h2>Create Room</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="post" class="card p-3 shadow-sm">
        <div class="mb-3">
            <label class="form-label">Room Number</label>
            <input asp-for="RoomNumber" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Room Type</label>
            <select asp-for="RoomTypeId" class="form-select" required>
                @foreach (var type in roomTypes)
                {
                    <option value="@type.Id">@type.Name</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Hotel</label>
            <select asp-for="HotelId" class="form-select" required>
                @foreach (var hotel in hotels)
                {
                    <option value="@hotel.Id">@hotel.Name</option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-success">Create</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>