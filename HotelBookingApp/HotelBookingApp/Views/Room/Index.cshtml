@model List<RoomListViewModel>

@{
    ViewBag.Title = "Rooms";
}

<div class="container mt-4">
    <h2 class="mb-4">Rooms</h2>

    <a class="btn btn-primary mb-3" asp-action="Create">Create New Room</a>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No rooms found.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Room Number</th>
                <th>Room Type</th>
                <th>Hotel</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var room in Model)
            {
                <tr>
                    <td>@room.Id</td>
                    <td>@room.RoomNumber</td>
                    <td>@room.RoomTypeName</td>
                    <td>@room.HotelName</td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@room.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@room.Id">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>