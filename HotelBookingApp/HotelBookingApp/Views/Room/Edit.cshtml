@model EditRoomViewModel

<div class="container mt-4">
    <h2>Edit Room</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="post" class="card p-3 shadow-sm">
        <input type="hidden" asp-for="Room.Id" />

        <div class="mb-3">
            <label class="form-label">Room Number</label>
            <input asp-for="Room.RoomNumber" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Room Type</label>
            <select asp-for="Room.RoomTypeId" class="form-select" asp-items="@(new SelectList(Model.RoomTypes, "Id", "Name", Model.Room.RoomTypeId))"></select>
        </div>

        <div class="mb-3">
            <label class="form-label">Hotel</label>
            <select asp-for="Room.HotelId" class="form-select" asp-items="@(new SelectList(Model.Hotels, "Id", "Name", Model.Room.HotelId))"></select>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="Room.IsAvailable" class="form-check-input" type="checkbox" />
            <label class="form-check-label" asp-for="Room.IsAvailable">Available</label>
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>