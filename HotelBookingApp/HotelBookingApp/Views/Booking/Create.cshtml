@model HotelBookingApp.Dto.BookingDto

<div class="container mt-4">
    <h2>Create Booking</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="post" class="card p-3 shadow-sm">
        <div class="mb-3">
            <label class="form-label">Hotel ID</label>
            <input asp-for="HotelId" class="form-control" required/>
        </div>
        <div class="mb-3">
            <label class="form-label">Room ID</label>
            <input asp-for="RoomId" class="form-control" required/>
        </div>
        <div class="row mb-3">
            <div class="col">
                <label class="form-label">Check-In Date</label>
                <input asp-for="CheckInDate" type="date" class="form-control" required/>
            </div>
            <div class="col">
                <label class="form-label">Check-Out Date</label>
                <input asp-for="CheckOutDate" type="date" class="form-control" required/>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Status</label>
            <input asp-for="Status" class="form-control" value="Confirmed"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Special Request</label>
            <textarea asp-for="SpecialRequest" class="form-control" placeholder="Any special instructions..."></textarea>
        </div>
        <button type="submit" class="btn btn-success">Create</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>