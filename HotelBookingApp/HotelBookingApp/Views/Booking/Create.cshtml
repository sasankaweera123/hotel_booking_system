@model BookingCreateViewModel

<h2>Create Booking</h2>

<form asp-action="Create" method="post">
    @if (!User.IsInRole("Manager"))
    {
        <div class="mb-3">
            <label>Hotel</label>
            <select asp-for="SelectedHotelId" class="form-select" 
                    asp-items="@(new SelectList(Model.Hotels, "Id", "Name"))"></select>
        </div>
    }
    else
    {
        <p><strong>Hotel:</strong> @Model.Hotels.FirstOrDefault(h => h.Id == Model.SelectedHotelId)?.Name</p>
        <input type="hidden" asp-for="SelectedHotelId" />
    }

    <div class="mb-3">
        <label>Room</label>
        <select asp-for="Booking.RoomId" class="form-select" 
                asp-items="@(new SelectList(Model.Rooms, "Id", "RoomTypeId"))"></select>
    </div>

    <div class="mb-3">
        <label>Customer Name</label>
        <input asp-for="Booking.CustomerName" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Customer NIC</label>
        <input asp-for="Booking.CustomerNic" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Check-In</label>
        <input asp-for="Booking.CheckInDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Check-Out</label>
        <input asp-for="Booking.CheckOutDate" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>