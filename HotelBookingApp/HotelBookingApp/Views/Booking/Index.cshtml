@model List<BookingListViewModel>

@{
    ViewBag.Title = "My Bookings";
}

<div class="container mt-4">
    <h2 class="mb-4">My Bookings</h2>

    <a class="btn btn-primary mb-3" asp-action="Create">Create New Booking</a>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No bookings found.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
            <tr>
                <th>Booking ID</th>
                <th>Hotel</th>
                <th>Room Number</th>
                <th>Room Type</th>
                <th>Status</th>
                <th>Check-In</th>
                <th>Check-Out</th>
                <th>Special Request</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.Id</td>
                    <td>@booking.HotelName</td>
                    <td>@booking.RoomNumber</td>
                    <td>@booking.RoomTypeName</td>
                    <td>@booking.Status</td>
                    <td>@booking.CheckInDate.ToShortDateString()</td>
                    <td>@booking.CheckOutDate.ToShortDateString()</td>
                    <td>@booking.SpecialRequests</td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@booking.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@booking.Id">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>