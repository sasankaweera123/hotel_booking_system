@model HotelBookingApp.Dto.BookingDto
@inject HotelBookingApp.Services.RoomService RoomService

@{
    ViewBag.Title = "Delete Booking";

    var hotels = await RoomService.GetHotelsAsync();
    var rooms = await RoomService.GetRoomsAsync();
    var roomTypes = await RoomService.GetRoomTypesAsync();

    var hotel = hotels.FirstOrDefault(h => h.Id == Model.HotelId);
    var room = rooms.FirstOrDefault(r => r.Id == Model.RoomId);
    var roomType = room != null ? roomTypes.FirstOrDefault(rt => rt.Id == room.RoomTypeId) : null;
}

<div class="container mt-4">
    <h2>Delete Booking</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this booking <strong>@Model.Id</strong>?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Hotel</dt>
        <dd class="col-sm-9">@hotel?.Name ?? "Unknown"</dd>

        <dt class="col-sm-3">Room</dt>
        <dd class="col-sm-9">@room?.RoomNumber ?? "Unknown"</dd>

        <dt class="col-sm-3">Room Type</dt>
        <dd class="col-sm-9">@roomType?.Name ?? "Unknown"</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">Check-In</dt>
        <dd class="col-sm-9">@Model.CheckInDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Check-Out</dt>
        <dd class="col-sm-9">@Model.CheckOutDate.ToShortDateString()</dd>
    </dl>

    <form method="post" asp-action="DeleteConfirmed" asp-route-id="@Model.Id">
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>