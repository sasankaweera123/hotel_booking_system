@model HotelBookingApp.Dto.BookingDto
@inject HotelBookingApp.Services.RoomService RoomService

@{
    ViewBag.Title = "Edit Booking";

    var hotels = await RoomService.GetHotelsAsync();
    var rooms = await RoomService.GetRoomsAsync();
    var roomTypes = await RoomService.GetRoomTypesAsync();

    var selectedRoom = rooms.FirstOrDefault(r => r.Id == Model.RoomId);
    var selectedRoomType = selectedRoom != null
        ? roomTypes.FirstOrDefault(rt => rt.Id == selectedRoom.RoomTypeId)
        : null;
}

<div class="container mt-4">
    <h2>Edit Booking</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="post" class="card p-3 shadow-sm">
        <input type="hidden" asp-for="Id"/>

        <div class="mb-3">
            <label class="form-label">Hotel</label>
            <select asp-for="HotelId" class="form-select" required>
                @foreach (var hotel in hotels)
                {
                    <option value="@hotel.Id" selected="@(hotel.Id == Model.HotelId)">
                        @hotel.Name
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Room</label>
            <select asp-for="RoomId" class="form-select" required>
                @foreach (var room in rooms)
                {
                    <option value="@room.Id" selected="@(room.Id == Model.RoomId)">
                        Room @room.RoomNumber (Hotel: @hotels.FirstOrDefault(h => h.Id == room.HotelId)?.Name)
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Room Type</label>
            @{
                var roomTypeName = selectedRoomType?.Name ?? "Unknown";
            }

            <input type="text" class="form-control" value="@roomTypeName" readonly />

        </div>

        <div class="row mb-3">
            <div class="col">
                <label class="form-label">Check-In Date</label>
                <input asp-for="CheckInDate" type="date" class="form-control" required/>
            </div>
            <div class="col">
                <label class="form-label">Check-Out Date</label>
                <input asp-for="CheckOutDate" type="date" class="form-control" required/>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Status</label>
            <select asp-for="Status" class="form-select">
                <option value="Confirmed" selected="@(Model.Status == "Confirmed")">Confirmed</option>
                <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
            </select>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Special Request</label>
            <input asp-for="SpecialRequest" class="form-control" />
        </div>  

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>
